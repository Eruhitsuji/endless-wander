{
  "name": "endless-wander",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": {
    "name": "Eruhitsuji",
    "email": "132959232+Eruhitsuji@users.noreply.github.com"
  },
  "description": "Seeded voxel walking sandbox with a browser edition and Electron desktop builds.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "chat.eruhitsuji.endlesswander",
    "productName": "Endless Wander",
    "directories": {
      "output": "dist"
    },
    "files": [
      "site/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Eruhitsuji",
        "repo": "endless-wander",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "maintainer": "132959232+Eruhitsuji@users.noreply.github.com"
    }
  }
}
